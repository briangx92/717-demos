# Copy to .env and edit. Never commit .env. Secrets live in files under data/, not here.
PORTAL_BIND=127.0.0.1
PORTAL_PORT=8787
PORTAL_DATA_DIR=./data
# Browsers allowed to call the API (comma separated, exact origins).
PORTAL_ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765
# Artists the form may name (comma separated slugs). Empty means any slug-shaped value.
PORTAL_ARTISTS=lex,liv,diana
# Set to 1 only behind Cloudflare or another proxy you control (uses CF-Connecting-IP).
PORTAL_TRUST_PROXY=0
